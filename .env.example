# Copy to .env.local and fill in from the Firebase console (Project settings > Your apps > Web app).
# Without these the app still runs: detection, review and replacement work on-device, and the
# cloud cleanup step is switched off.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloud cleanup model. Set gemini-3.8-flash to compare quality with Flash-Lite.
VITE_CLOUD_MODEL=gemini-3.5-flash-lite

# App Check: reCAPTCHA Enterprise site key for the hosted site:
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local app / unpacked extension only: Firebase console > App Check > Apps > your web app
# > Manage debug tokens > create token. Paste that token here (not "true").
# Keep the token and generated builds private. Never publish a debug build.
VITE_APPCHECK_DEBUG_TOKEN=
