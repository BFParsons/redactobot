// Cloudflare Workers static hosting for the web app (redactobot.org).
// Cloudflare runs `npm run build`, then `npx wrangler deploy` uploads ./dist.
// There is no server code: the site is static files only. Response headers
// come from public/_headers, which the build copies into dist.
{
  "name": "redactobot",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
  },
  // Serve the site on the project's own domain. Cloudflare creates the DNS
  // records and certificates for these on deploy.
  "routes": [
    {"pattern": "redactobot.org", "custom_domain": true},
    {"pattern": "www.redactobot.org", "custom_domain": true},
  ],
}
